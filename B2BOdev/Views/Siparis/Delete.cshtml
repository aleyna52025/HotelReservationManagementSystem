@model B2BOdev.Models.Siparis

@{
    ViewData["Title"] = "Sipariş Sil";
}

<h2>Sipariş Sil</h2>

<h3>Bu siparişi silmek istediğinize emin misiniz?</h3>

<div>
    <h4>Sipariş Detayları</h4>
    <dl class="row">
        <dt class="col-sm-2">Sipariş No</dt>
        <dd class="col-sm-10">@Model.SipNo</dd>

        <dt class="col-sm-2">Firma</dt>
        <dd class="col-sm-10">@Model.Firma?.FirmaUnvanı</dd>

        <dt class="col-sm-2">Tarih</dt>
        <dd class="col-sm-10">@Model.Tarih.ToShortDateString()</dd>

        <dt class="col-sm-2">Durum</dt>
        <dd class="col-sm-10">@Model.Durum?.durumu</dd>

        <dt class="col-sm-2">Adres</dt>
        <dd class="col-sm-10">@Model.Adres?.Adres1</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="SipID" />
        <button type="submit" class="btn btn-danger">Sil</button>
        <a asp-action="Index" class="btn btn-secondary">İptal</a>
    </form>
</div>
