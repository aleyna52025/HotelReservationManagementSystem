@model IEnumerable<B2BOdev.Models.Kategori>
@{
    ViewData["Title"] = "Kategori";
}
@{
    var userName = Context.Session.GetString("UserName");
     var personelYetki = Context.Session.GetString("Personel");
}
<br />
<br />

<div class="d-flex justify-content-end mb-3">
    <input type="text" id="searchInput" class="form-control w-50" placeholder="Kategori Adı Girin." />
      
    </div>

      @if (personelYetki == "1")
{
    <a href="#" class="btn btn-sm btn-warning edit-birim-btn"
                   data-url="@Url.Action("EditPartial", "Kategori", new { id = 0})">
                            Yeni
                        </a>}
    <h2 class="text-center">Kategori Listesi</h2>
<table class="table table-striped table-bordered" id="birimTable">
        <thead class="table-dark">
            <tr>
                <th>Üst Kategori Adı</th>
                <th>Kategori Tipi</th>
                <th>Alt Kategori Adı</th>

                <th>İşlem</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var Kategori in Model)
            {
                <tr>
                <td>@Kategori.UstKategori?.KategoriAd </td>

                    <td>@Kategori.KategoriTip</td>
                    <td>@Kategori.KategoriAd</td>
                @if (personelYetki == "1")
                {
                    <td>
                         <a href="@Url.Action("DeleteConfirmed", "Kategori", new { id = Kategori.KategoriId })" class="btn btn-sm btn-danger">Sil</a>
                    </td>
                }
                </tr>
            }
        </tbody>
    </table>


<!-- Modal -->
<div class="modal fade" id="editBirimModal" tabindex="-1" aria-labelledby="editBirimModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg">
            <div class="modal-header">
                <h5 class="modal-title" id="editBirimModalLabel">Kategori Düzenle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body" id="modalContent">
                <!-- PartialView buraya ajax ile gelecek -->
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById("searchInput").addEventListener("keyup", function () {
            var input = this.value.toLowerCase();
            var rows = document.querySelectorAll("#birimTable tbody tr");

            rows.forEach(function (row) {
                var kategoriad = row.children[0].textContent.toLowerCase();
            

                if (kategoriad.includes(input)  ) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        });
        //js modal kodlarım

            document.querySelectorAll(".edit-birim-btn").forEach(function (btn) {
            btn.addEventListener("click", function (e) {
                e.preventDefault();
                const url = this.getAttribute("data-url");

                fetch(url)
                    .then(response => response.text())
                    .then(html => {
                        document.getElementById("modalContent").innerHTML = html;
                        const modal = new bootstrap.Modal(document.getElementById("editBirimModal"));
                        modal.show();

                        setTimeout(() => {
                            bindEditFormSubmit();
                        }, 100);
                    });
            });
        });

        function bindEditFormSubmit() {
            const form = document.getElementById("editBirimForm");
            if (!form) return;

            form.addEventListener("submit", function (e) {
                e.preventDefault();

                const formData = new FormData(form);
                fetch(form.action, {
                    method: "POST",
                    body: formData
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            location.reload();
                        } else {
                            alert("Bir hata oluştu.");
                        }
                    });
            });
        }



    </script>
    }
 