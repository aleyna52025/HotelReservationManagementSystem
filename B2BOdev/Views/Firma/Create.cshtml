@model B2BOdev.Models.Firma
@{
    ViewData["Title"] = "Yeni Firma Ekle";
}

<h2 class="text-center mb-4">Yeni Firma Ekle</h2>

<div class="row justify-content-center">
    <div class="col-md-8">
        <form asp-action="Create" method="post">
            <div class="card shadow p-4">
                <div class="mb-3">
                    <label asp-for="FirmaKod" class="form-label">Firma Kodu</label>
                    <input asp-for="FirmaKod" class="form-control" />
                    <span asp-validation-for="FirmaKod" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="FirmaUnvanı" class="form-label">Firma Ünvanı</label>
                    <input asp-for="FirmaUnvanı" class="form-control" />
                    <span asp-validation-for="FirmaUnvanı" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="VergiNo" class="form-label">Vergi No</label>
                    <input asp-for="VergiNo" class="form-control" />
                    <span asp-validation-for="VergiNo" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="VergiDairesi" class="form-label">Vergi Dairesi</label>
                    <input asp-for="VergiDairesi" class="form-control" />
                    <span asp-validation-for="VergiDairesi" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Eposta" class="control-label"></label>
                    <input asp-for="Eposta" class="form-control" />
                    <span asp-validation-for="Eposta" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="tel" class="control-label"></label>
                    <input asp-for="tel" class="form-control" />
                    <span asp-validation-for="tel" class="text-danger"></span>
                </div>
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">İptal</a>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
