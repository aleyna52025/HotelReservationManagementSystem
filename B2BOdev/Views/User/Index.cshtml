@model List<B2BOdev.Models.User>

@{
    ViewData["Title"] = "Kullanıcı Listesi";
}

<h2 class="text-primary">Kullanıcı Listesi</h2>

<a asp-action="Create" class="btn btn-success mb-3">Yeni Kullanıcı Ekle</a>

<table class="table table-bordered table-striped">
    <thead class="thead-dark">
        <tr>
            <th>Email</th>
            <th>Ad</th>
            <th>Soyad</th>
            <th>Yetki</th>
            <th>Firma</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.email</td>
                <td>@item.Ad</td>
                <td>@item.Soyad</td>
                <td>
                    @(item.Personel == "1" ? "Yönetici" : "Görüntüleyici")
                </td>
                <td>
                    @item.firma?.FirmaUnvanı
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.UserID" class="btn btn-sm btn-primary">Düzenle</a>
                    <a asp-action="Delete" asp-route-id="@item.UserID" class="btn btn-sm btn-danger">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>
