@model IEnumerable<B2BOdev.Models.Adres>

@{
    ViewData["Title"] = "Adres Listesi";
    var kullaniciYetki = Context.Session.GetString("Personel");
}

<h2>Adres Listesi</h2>

@if (kullaniciYetki == "1")
{
    <a href="#" class="btn btn-sm btn-success edit-adres-btn"
   data-url="@Url.Action("EditPartial", "Adres", new { id = 0 })">
        Yeni Adres
    </a>
}

<table class="table table-bordered table-striped mt-3">
    <thead>
        <tr>
            <th>Adres 1</th>
            <th>Adres 2</th>
            <th>İl</th>
            <th>İlçe</th>
            <th>Mahalle</th>
            <th>Telefon</th>
            <th>Fax</th>
            <th>Cep Tel</th>
            <th>Firma</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Adres1</td>
                <td>@item.Adres2</td>
                <td>@item.Il?.IlAdi</td>
                <td>@item.Ilce?.IlceAdi</td>
                <td>@item.Mahalle</td>
                <td>@item.Tel</td>
                <td>@item.Fax</td>
                <td>@item.CepTel</td>
                <td>@item.firma?.FirmaUnvanı</td>
                <td>
                    @if (kullaniciYetki == "1")
                    {
                        <button class="btn btn-sm btn-primary edit-adres-btn"
                        data-url="@Url.Action("EditPartial", "Adres", new { id = item.AdresID })">
                            Düzenle
                        </button>
                        <a asp-action="Details" asp-route-id="@item.AdresID" class="btn btn-sm btn-info">Detay</a>
                        <a asp-action="Delete" asp-route-id="@item.AdresID" class="btn btn-sm btn-danger">Sil</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="editModalBody">
            <!-- Partial view burada AJAX ile yüklenecek -->
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        $(function () {
            // Modal açma
            $(document).on('click', '.edit-adres-btn', function (e) {
                e.preventDefault();
                var url = $(this).data('url');

                $.get(url, function (html) {
                    $('#editModalBody').html(html);
                    $('#editModal').modal('show');
                });
            });

            // Formu AJAX ile submit etme
            $(document).on('submit', '#editAdresForm', function (e) {
                e.preventDefault();

                var formData = $(this).serialize();

                $.ajax({
                    url: '@Url.Action("EditPartial", "Adres")',
                    type: 'POST',
                    data: formData,
                    success: function (response) {
                        if (response.success) {
                            $('#editModal').modal('hide');
                            location.reload(); // Sayfayı yenile veya tabloyu güncelle
                        } else {
                            $('#editModalBody').html(response); // Validasyon hatası varsa formu tekrar göster
                        }
                    },
                    error: function () {
                        alert("Bir hata oluştu.");
                    }
                });
            });
        });
    </script>
}
