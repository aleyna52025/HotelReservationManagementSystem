@model IEnumerable<B2BOdev.Models.Durum>
@{
    ViewData["Title"] = "Sevk Biilgileri";
    var userName = Context.Session.GetString("UserName");
     var personelYetki = Context.Session.GetString("Personel");
}
 <br />
    <br />
    <br />
    
<div class="d-flex justify-content-between mb-3">
    
    <input type="text" id="searchInput" class="form-control w-50" placeholder="Durum ID veya adı ara..." />
    
</div>

@if (personelYetki == "1")
{
    <a href="#" class="btn btn-sm btn-warning edit-birim-btn"
   data-url="@Url.Action("EditPartial", "Durum",new { id = 0 })">
        Düzenle
    </a>
}
<h2 class="text-center">Sevk Bilgileri</h2>

<table class="table table-striped table-bordered" id="Durumtablo">
    <thead class="table-dark">
        <tr>
            <th>Durum ID</th>
            <th>Durumu</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var durum in Model)
        {
            <tr>
                <td>@durum.durumId</td>
                <td>@durum.durumu</td>@if (personelYetki == "1")
                {
                    <td>
                   <a href="#" class="btn btn-sm btn-warning edit-birim-btn"
                   data-url="@Url.Action("EditPartial", "Durum", new { id = durum.durumId})">
                            Düzenle
                        </a> <a href="@Url.Action("DeleteConfirmed", "Durum", new { id = durum.durumId })" class="btn btn-sm btn-danger">Sil</a>
                </td>
                }
            </tr>
        }
    </tbody>
</table>
    <!-- Modal -->
<div class="modal fade" id="editDurumModal" tabindex="-1" aria-labelledby="editBirimModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg">
            <div class="modal-header">
                <h5 class="modal-title" id="editBirimModalLabel">Marka Düzenle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body" id="modalContent">
                <!-- PartialView buraya ajax ile gelecek -->
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        document.getElementById("searchInput").addEventListener("keyup", function () {
            var input = this.value.toLowerCase();
            var rows = document.querySelectorAll("#Durumtablo tbody tr");

            rows.forEach(function (row) {
                
                var durumu = row.children[1].textContent.toLowerCase();

                if (durumu.includes(input) ) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        });

        //js kodları modalın
        document.querySelectorAll(".edit-birim-btn").forEach(function (btn) {
            btn.addEventListener("click", function (e) {
                e.preventDefault();
                const url = this.getAttribute("data-url");

                fetch(url)
                    .then(response => response.text())
                    .then(html => {
                        document.getElementById("modalContent").innerHTML = html;
                        const modal = new bootstrap.Modal(document.getElementById("editDurumModal"));
                        modal.show();

                        setTimeout(() => {
                            bindEditFormSubmit();
                        }, 100);
                    });
            });
        });

        function bindEditFormSubmit() {
            const form = document.getElementById("editBirimForm");
            if (!form) return;

            form.addEventListener("submit", function (e) {
                e.preventDefault();

                const formData = new FormData(form);
                fetch(form.action, {
                    method: "POST",
                    body: formData
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            location.reload();
                        } else {
                            alert("Bir hata oluştu.");
                        }
                    });
            });
        }

    </script>
}
