@model B2BOdev.Models.Durum
@{
    ViewData["Title"] = "Yeni Durum Ekle";
}

<h2 class="text-center mb-4">Yeni Durum Ekle</h2>

<div class="row justify-content-center">
    <div class="col-md-8">
        <form asp-action="Create" method="post">
            <div class="card shadow p-4">
                <div class="mb-3">
                    <label asp-for="durumu" class="form-label">Durum Adı</label>
                    <input asp-for="durumu" class="form-control" />
                    <span asp-validation-for="durumu" class="text-danger"></span>
                </div>
                 

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">İptal</a>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
